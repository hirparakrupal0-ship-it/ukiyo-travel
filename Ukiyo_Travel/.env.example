# =============================================================================
# Ukiyo Travel — configuration (copy to ".env" in this folder and edit)
#   cp .env.example .env
# One file configures the shared backend AND both panels. Never commit ".env".
# =============================================================================

# ---------------- Shared backend (API) ----------------
PORT=5000
NODE_ENV=development

# The ONE MongoDB database used by both panels (through the backend).
#   Local:  mongodb://127.0.0.1:27017/ukiyo_travel
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/ukiyo_travel?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ukiyo_travel

# Secret used to sign login tokens — use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (the two panels). Comma-separated, no trailing slash.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# Business timezone: decides what "today" is for the past-date rule and analytics.
APP_TIMEZONE=Asia/Kolkata

# First admin account, created by `npm run seed:admin`. Change the password!
ADMIN_EMAIL=admin@ukiyo.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Bring old Smart/Command Center records up to date on server start (safe, idempotent).
AUTO_MIGRATE=true

# ---------------- Payments ----------------
# With Razorpay keys set, real Razorpay checkout is used (use TEST keys while developing).
# With no keys, the built-in SANDBOX gateway is used (nothing is charged):
#   success: any valid UPI id / card 4242 4242 4242 4242 / any bank
#   decline: UPI id containing "fail" (e.g. test@fail) / card 4000 0000 0000 0002
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: lets Razorpay confirm payments server-to-server (POST /api/payments/webhook).
RAZORPAY_WEBHOOK_SECRET=
# Sandbox switch. Defaults to ON in development and OFF in production; it is always off when Razorpay is configured.
DEMO_PAYMENTS=true

# ---------------- Panels (static sites) ----------------
USER_PORT=3000
ADMIN_PORT=3001
# Where the BROWSER reaches the backend, and where each panel lives (used for cross-links).
API_URL=http://localhost:5000
USER_PANEL_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001
